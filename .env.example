# Copy this file to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.

# Your live domain, without a trailing slash. Used for canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://www.tarkeon.in

# ---------- Leads by email (Resend) ----------
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Where new leads are sent (you). Defaults to the email in content/site.ts
LEAD_TO_EMAIL=tarkeontechnologies@gmail.com
# Sender address. Must use a domain you verified in Resend (Domains → Add domain).
# Until then, "Tarkeon <onboarding@resend.dev>" works but can only send to your own Resend account email.
LEAD_FROM_EMAIL=Tarkeon <hello@tarkeon.in>

# ---------- Leads to Google Sheets (optional) ----------
# Web app URL of the Apps Script in docs/google-sheet-webhook.gs
GOOGLE_SHEET_WEBHOOK_URL=

# ---------- Free website check (homepage) ----------
# Google PageSpeed Insights API key. Free. See README → "PageSpeed API key".
# Without it the check uses Google's shared anonymous quota, which is often used up.
PAGESPEED_API_KEY=

# ---------- Google Analytics 4 (optional) ----------
# e.g. G-XXXXXXXXXX. When set, GA loads only after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=
